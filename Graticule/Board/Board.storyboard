<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="BoardVC">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
    </dependencies>
    <scenes>
        <scene sceneID="board-scene">
            <objects>
                <viewController id="BoardVC" customClass="BoardViewController" customModule="Graticule" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="board-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    </view>
                    <connections>
                        <segue destination="onb-ref" kind="presentation" identifier="showOnboarding" modalPresentationStyle="fullScreen" id="seg-onb"/>
                        <segue destination="fix-ref" kind="presentation" identifier="showFixtures" modalPresentationStyle="pageSheet" id="seg-fix"/>
                        <segue destination="std-ref" kind="presentation" identifier="showStandings" modalPresentationStyle="pageSheet" id="seg-std"/>
                        <segue destination="set-ref" kind="presentation" identifier="showSettings" modalPresentationStyle="pageSheet" id="seg-set"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="board-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
        <scene sceneID="onb-ref-scene">
            <objects>
                <viewControllerPlaceholder storyboardName="Onboarding" referencedIdentifier="OnboardingVC" id="onb-ref" sceneMemberID="viewController"/>
